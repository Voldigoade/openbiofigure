{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBioFigure",
  "version": "0.2.1",
  "identifier": "io.github.voldigoade.openbiofigure",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "OpenBioFigure",
        "url": "index.html?desktop-recovery=0.2.1",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "category": "GraphicsAndDesign",
    "copyright": "Copyright Voldigoade",
    "shortDescription": "Scientific figure editor with provenance tracking",
    "longDescription": "A local-first scientific figure editor with vector export and asset provenance tracking.",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
